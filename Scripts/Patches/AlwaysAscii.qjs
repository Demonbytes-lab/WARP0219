///
/// \brief NOP out the conditional jump after comparison inside CSession::IsOnlyEnglish
///
AlwaysAscii = function(_)
{
	$$(_, 1, `Find the comparison`)
	let code;
	if (Exe.Version <= 11) //VC6 - VC11
	{
		code =
			TEST(BYTE_PTR, [R32, R32], 0x80)  //test byte ptr [regA + regB], 80h
		+	JNZ(WCp)                          //jnz short _skip
		;
	}
	else
	{
		code =
			CMP(BYTE_PTR, [R32, R32], 0)      //cmp byte ptr [regA + regB], 0
		+	JL(WCp)                           //jl short _skip
		+	INC(R32)                          //inc regC
		;
	}

	const addr = Exe.FindHex(code);
	if (addr < 0)
	{
		$$(_, 1.2, `Check whether the jump has already been NOPed out (client shipped pre-patched)`)
		///  The 2026-02-19 base exe already carries this patch: CSession::IsOnlyEnglish at
		///  0x00DFA630 reads 'cmp byte ptr [eax+edx],0 / nop / nop / inc eax' - i.e. the 2 byte
		///  JL is gone, which is exactly what step 2 below would have written. Report it as a
		///  no-op instead of a failure. The comparison itself is otherwise byte-identical to
		///  2025-07-16 (0x00D71F10), so nothing about the function actually changed.
		const done = Exe.Version <= 11
			? TEST(BYTE_PTR, [R32, R32], 0x80) + NOP + NOP
			: CMP(BYTE_PTR, [R32, R32], 0) + NOP + NOP + INC(R32)
		;

		if (Exe.FindHex(done) > 0)
			Cancel("ASCII check is already disabled");

		throw Error("IsOnlyEnglish not found");
	}

	$$(_, 2, `NOP out the jump`)
	Exe.SetNOPs(addr + 4, 2);

	return true;
};
