///
/// \brief Infinite intravision patch (Always see cloaked objects)
///
Intravision = function(_)
{
	$$(_, 1, `Find the comparison loop`)
	let parts, partsAlt;
	if (!ROC.Post2010)
	{
		parts =
			JNE(2)                      //jne short _skip
		+	MOV(BL, 1)                  //mov bl, 1
		+	INC(ECX)                    //inc ecx ; _skip
		+	JMP(WCn)                    //jmp short _loop
		+	CMP(BL, 1)                  //cmp bl, 1
		;
	}
	else
	{
		const imm8A = (Exe.BuildDate >= 20120700 || (ROC.IsRenewal && Exe.BuildDate >= 20120300 )) ? ' [00010.00]' : ' 0C';
		const jzA = Exe.BuildDate > 20210200 ? JZ(WCp) : JZ(ALLWC);

		parts =
		[
			jzA                         //jz _next
		,
			ADD(EAX, imm8A)             //add eax, imm8A  ; 14h in 2017 clients
		+	CMP(EAX, ECX)               //cmp eax, ecx
		+	JNZ(WCn)                    //jnz short _loop
		];

		//The loop walks the status list one entry at a time, so the ADD immediate is the
		//size of a single status entry. That grew from 14h to 1Ch on the 2026 clients, which
		//is outside the ' [00010.00]' mask above (it only covers 10h & 14h) - hence a wider
		//mask (10h/14h/18h/1Ch) kept as a fallback. Step 2 filters out the extra candidates.
		partsAlt =
		[
			jzA                         //jz _next
		,
			ADD(EAX, ' [0001..00]')     //add eax, imm8A  ; 1Ch in 2026 clients
		+	CMP(EAX, ECX)               //cmp eax, ecx
		+	JNZ(WCn)                    //jnz short _loop
		];
	}

	let addrs = Exe.FindHexN(parts);
	if (addrs.isEmpty() && partsAlt)
		addrs = Exe.FindHexN(partsAlt);

	if (addrs.isEmpty())
		throw Error("Comparison missing");

	$$(_, 2, `Change the JZ/JNE SHORT to JMP for the right match`)
	const code =
		PUSH_2							//push 2
	+	MOV(ECX, ESI)					//mov ecx, esi
	+	CALL()							//call func#1
	;
	const filter = list => list.filter( addr =>
	{
		if (Exe.FindHex(code, addr - 0x30, addr) > 0)
		{
			Exe.SetJMP(addr);
			return true;
		}
		else
		{
			return false;
		}
	});

	let found = filter(addrs);

	//Nothing was modified when the filter comes back empty, so retrying with the wider
	//entry size mask cannot double patch anything.
	if (found.isEmpty() && partsAlt)
		found = filter(Exe.FindHexN(partsAlt));

	if (found.isEmpty())
		throw Error("Only false matches found");

	return true;
};
