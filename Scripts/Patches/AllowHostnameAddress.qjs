AllowHostnameAddress = function(_)
{
	$$(_, 1.1, `Find the colon test that gates gethostbyname`)
	const gate = Exe.FindHex("6A FF 68 ?? ?? ?? ?? 8D 4D ?? E8 ?? ?? ?? ?? 83 F8 FF 74 ?? 50 6A 00 8D 45 ?? 50")
	if (gate < 0)
		throw Error("Hostname gate not found");

	$$(_, 1.2, `NOP the jump so the whole address resolves via gethostbyname`)
	Exe.SetHex(gate + 18, "90 90");

	return true;
};

AllowHostnameAddress.validate = () => Exe.FindHex("6A FF 68 ?? ?? ?? ?? 8D 4D ?? E8 ?? ?? ?? ?? 83 F8 FF 74 ?? 50 6A 00 8D 45 ?? 50") > 0;
