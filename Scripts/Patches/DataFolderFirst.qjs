///
/// \brief Change all JZ/JNZ/CMOVNZ after g_readFolderFirst comparison to NOP/JMP/MOV.
///        Also sets g_readFolderFirst to 1 in the process as failsafe.
///
DataFolderFirst = function(_)
{
	if (Exe.BuildDate >= 20250300) {
		$$(_, 0.1, `Find the new DataFolderFirst pattern (2025+)`)
		let p2025 = "0F 84 ?? ?? ?? ?? 6A 00 68 80 00 00 00 6A 03 6A 00 6A 01 68 00 00 00 80 FF 75 08 FF 15 ?? ?? ?? ?? 8B 5D 0C 8B F8 83 FF FF";
		let a2025 = Exe.FindHex(p2025);
		if (a2025 > 0)
		{
			$$(_, 0.2, `NOP out the JZ near (0F 84 ...)`)
			Exe.SetNOPs(a2025, 6); // 0F 84 xx xx xx xx  =>  90 90 90 90 90 90
			return true;
		}

		/**==================================================================
		2026-02-19 - there is no g_readFolderFirst flag left to force.

		On 2025-07-16 CFileMgr::Read @00A88AA8 did everything in one body and
		picked its path from that flag:
			00A88B80  cmp byte ptr [159D40C], 0     ; g_readFolderFirst
			00A88B87  je   00A88C71                 ; -> GRF path
			00A88B8D  <CreateFileA ...>             ; -> data folder path
		which is the JZ the branch above NOPs out.

		On 2026-02-19 that function was split into two helpers and a two line
		dispatcher, and the flag disappeared with it. CFileMgr::Read is now
		00AE9BF0 (this = g_fileMgr 016D5688, called from 0057C146):

			00AE9BF6  push ecx                      ; save 'this'
			00AE9BF7  push [ebp+0Ch] / push [ebp+8]
			00AE9BFD  call 00AE9FE0                 ; search the GRF list
			00AE9C02  pop  ecx                      ; restore 'this'
			00AE9C03  test eax, eax
			00AE9C05  jne  00AE9C12                 ; got it - done
			00AE9C07  push [ebp+0Ch] / push [ebp+8]
			00AE9C0D  call 00AE9EE0                 ; CreateFileA on disk

		So the order is simply GRF then folder, and putting the data folder
		first means swapping the two CALL targets. That works verbatim with
		the surrounding code: the disk helper takes its arguments on the
		stack and ignores ECX, while the GRF helper needs ECX = this - and
		'this' is already saved across the first call and restored right
		before the second one.

		Which helper is which is decided by looking for the CreateFileA
		argument block inside the target rather than by assuming the order,
		so a second run detects the swap instead of undoing it.

		Measured: the dispatcher pattern occurs exactly once on 2026-02-19
		and not at all on 2025-07-16 (which still has the single body form
		handled above), so this cannot fire on the older client.
		==================================================================**/
		const parts =
		[//0
			PUSH([EBP, 0xC])  //push dword ptr [ARG.2]
		+	PUSH([EBP, 0x8])  //push dword ptr [ARG.1]

		,//1
			CALL(ALLWC)       //call <lookup #1>

		,//2
			POP(ECX)          //pop ecx                ; restore 'this'
		+	TEST(EAX, EAX)    //test eax, eax
		+	JNE(0x0B)         //jne short _done        ; skips exactly the 11 bytes below
		+	PUSH([EBP, 0xC])  //push dword ptr [ARG.2]
		+	PUSH([EBP, 0x8])  //push dword ptr [ARG.1]

		,//3
			CALL(ALLWC)       //call <lookup #2>
		];

		const addr = Exe.FindHex(parts);
		if (addr < 0)
			throw Error("New DataFolderFirst pattern not found (2025+)");

		$$(_, 0.3, `Resolve both lookup functions`)
		const call1 = addr + parts.byteCount(0);
		const call2 = addr + parts.byteCount(0, 2);

		const tgt1 = Exe.GetTgtAddr(call1 + 1); //VIRTUAL
		const tgt2 = Exe.GetTgtAddr(call2 + 1); //VIRTUAL

		$$(_, 0.4, `Identify the data folder one by its CreateFileA arguments`)
		const cfArgs =
			PUSH_0            //push 0                 ; hTemplateFile
		+	PUSH(0x80)        //push 80h               ; FILE_ATTRIBUTE_NORMAL
		+	PUSH(3)           //push 3                 ; OPEN_EXISTING
		+	PUSH_0            //push 0                 ; lpSecurityAttributes
		+	PUSH_1            //push 1                 ; FILE_SHARE_READ
		+	PUSH(0x80000000)  //push 80000000h         ; GENERIC_READ
		;

		const isDisk = tgtVir =>
		{
			const beg = Exe.Vir2Phy(tgtVir, CODE);
			return beg > 0 && Exe.FindHex(cfArgs, beg, beg + 0x40) > 0;
		};

		if (isDisk(tgt1))
		{
			$$(_, 0.5, `Data folder is already looked up first - nothing to do`)
			return true;
		}

		if (!isDisk(tgt2))
			throw Error("Data folder lookup not identified (2026+)");

		$$(_, 0.6, `Swap the two CALL targets so the data folder is tried first`)
		const vir1 = Exe.Phy2Vir(call1, CODE);
		const vir2 = Exe.Phy2Vir(call2, CODE);

		Exe.SetInt32(call1 + 1, tgt2 - (vir1 + 5));
		Exe.SetInt32(call2 + 1, tgt1 - (vir2 + 5));

		return true;
	}

	$$(_, 1.1, `Find the string 'loading'`)
	const addr = Exe.FindText("loading");
	if (addr < 0)
		throw Error("'loading' not found");

	$$(_, 1.2, `Find where it is PUSHed (g_readFolderFirst is assigned just above it)`)
	let code, repl, gloc, rloc;
	switch (Exe.Version)
	{
		case 6:  //VC6
		case 9:  // to
		case 10: //VC10
		{
			code =
				JZ(0x07)                    //jz short _skip#1 - skip the MOV below
			+	MOV(BYTE_PTR, [POS4WC], 1)  //mov byte ptr [g_readFolderFirst], 1
			+	PUSH(addr)                  //push offset "loading" ; _skip#1
			;
			repl = 0x9090;//Change JZ SHORT to NOPs
			gloc = 4;
			rloc = 0;
			break;
		}
		case 11:
		{
			code =
				CMOVNE(R32, R32)   //cmovne regA, regB
			+	MOV([POS4WC], R8)  //mov byte ptr [g_readFolderFirst], reg8A
			+	PUSH(addr)         //push offset "loading"
			;
			repl = 0x8B90;  //change CMOVNE to NOP + MOV
			gloc = 5;
			rloc = 0;
			break;
		}
		default: // VC14.16
		{
			code =
				PUSH(addr)         //push offset "loading"
			+	CMOVNE(R32, R32)   //cmovne regA, regB
			+	MOV([POS4WC], R8)  //mov byte ptr [g_readFolderFirst], reg8A
			;
			repl = 0x8B90;  //change CMOVNZ to NOP + MOV
			gloc = code.byteCount() - 4;
			rloc = 5;
			break;
		}
	}

	const addr2 = Exe.FindHex(code);
	if (addr2 < 0)
		throw Error("'loading' not PUSHed");

	$$(_, 1.2, `Change the conditional instruction appropriately (this is a failsafe)`)
	Exe.SetUint16(addr2 + rloc, repl);

	///===================================================================///
	/// Client also compares g_readFolderFirst even before it is assigned ///
	/// sometimes hence we also fix up the comparisons.                   ///
	///===================================================================///

	$$(_, 2.1, `Extract g_readFolderFirst`)
	const ReadFolderFirst = Exe.GetHex(addr2 + gloc, 4);
	if (Exe.Version === 6)
	{
		$$(_, 2.2, `Find the Comparison for VC6 Clients`)
		const addrs = Exe.FindHexN( MOV(AL, [ReadFolderFirst]) ); //mov al, byte ptr [g_readFolderFirst]
		if (addrs.isEmpty())
			throw Error("Comparisons not found (VC6)");

		addrs.forEach( (memAddr, idx) =>
		{
			const __ = `${_} [${idx}]`;

			$$(__, 2.3, `Find the conditional jump after each comparison`)
			const addr = Exe.FindHex( JE(POS2WC), memAddr + 0x5, memAddr + 0x20);//jz _skip#2
			if (addr < 0)
				throw Error(`No jump found for comparison No.${idx + 1} <b>for (VC6)</b>`);

			$$(__, 2.4, `NOP out the jump`)
			Exe.SetNOPs(addr, 6);
		});
	}
	else
	{
		$$(_, 3.1, `Find the Comparison for VC9+ Clients`)
		const addrs = Exe.FindHexN( CMP(BYTE_PTR, [ReadFolderFirst], 0) ); //CMP byte ptr [g_readFolderFirst], 0
		if (addrs.isEmpty())
			throw Error("Comparisons not found (VC9+)");
		
		const suf = ROC.FullVer == 14.29 ? PUSH_0 : CALL();
		addrs.forEach( (memAddr, idx) =>
		{
			const __ = `${_} [${idx}]`;

			$$(__, 3.2, `Find the conditional jump after each comparison`)
			const addr = Exe.FindHex( JZ(WCp) + suf, memAddr + 0x7, memAddr + 0x20);//jz short _skip#3
			                                                                        //call func#2 / push 0 for new clients
			if (addr < 0)
				throw Error(`No jump found for comparison No.${idx + 1} <b>for (VC9+)</b>`);

			$$(__, 3.3, `NOP out the jump`)
			Exe.SetNOPs(addr, 2);
		});
	}

	return true;
};
