const RestoreServiceSelectState0 =
	"8B 07 8B CF 6A 00 6A 00 6A 00 6A 00 6A 1C FF 50 18 E9" + ALLWC;

const RestoreServiceSelectDispatch =
	"83 F8 26 0F 87" + ALLWC + " 0F B6 80" + ALLWC + " FF 24 85" + ALLWC;

const RestoreServiceSelectBuilder =
	  "55 89 E5 83 EC 1C 53 56 57 8B 75 08"
	+ " C7 86 C4 01 00 00 00 00 00 00"
	+ " C7 86 C8 01 00 00 FF FF FF FF";

const RestoreServiceSelectListHook = builderVir =>
	  "8B 87 C4 01 00 00 80 3D" + ALLWC + " 01 75 09"
	+ " C6 05" + ALLWC + " 00 EB 0A"
	+ " 83 F8 01 7C 05 83 F8 08 7E 0A"
	+ " 60 57 B8" + builderVir.toHex() + " FF D0 61";

const RestoreServiceSelectPickHook =
	"80 3D" + ALLWC + " 01 74 06 68" + ALLWC + " C3 8B 43 04";

RestoreServiceSelect = function(__)
{
	const _ = Log.dive('RestoreServiceSelect');

	const signedRel32 = value =>
		value > 0x7FFFFFFF ? value - 0x100000000 : value;

	const findUnique = (pattern, label) =>
	{
		const addrs = Exe.FindHexN(pattern, 0, Exe.FileSize);
		if (addrs.length !== 1)
			throw Error(`${label} matched ${addrs.length} sites (expected 1)`);
		return addrs[0];
	};

	const assemble = (baseVir, items) =>
	{
		const size = item =>
			typeof item === "string" ? item.byteCount()
			: item.label !== undefined ? 0
			: item.short !== undefined ? 2
			: 5;

		const labels = {};
		let off = 0;
		for (const item of items)
		{
			if (item.label !== undefined)
				labels[item.label] = off;
			off += size(item);
		}

		let code = "";
		off = 0;
		for (const item of items)
		{
			if (typeof item === "string")
				code += " " + item;
			else if (item.short !== undefined)
			{
				const d = labels[item.to] - (off + 2);
				if (d < -128 || d > 127)
					throw Error(`Short jump to ${item.to} out of range`);
				code += " " + item.short + " " + (d & 0xFF).toHex(1);
			}
			else if (item.jmp !== undefined)
				code += " E9" + ((item.jmp - (baseVir + off + 5)) >>> 0).toHex();
			off += size(item);
		}
		return code;
	};

	$$(_, '1.1 - Find the login states that open the login window')
	const state0 = findUnique(RestoreServiceSelectState0, "Login state 0 block");
	const state0Vir = Exe.Phy2Vir(state0, CODE);
	const endVir = state0Vir + 22 + signedRel32(Exe.GetInt32(state0 + 18));

	let state2Vir = -1;
	for (const addr of Exe.FindHexN(RestoreServiceSelectDispatch))
	{
		const idxTbl = Exe.GetUint32(addr + 12);
		const jmpTbl = Exe.GetUint32(addr + 19);
		const target = st => Exe.GetUint32(Exe.Vir2Phy(jmpTbl + 4 * Exe.GetUint8(Exe.Vir2Phy(idxTbl + st))));
		if (target(0) !== state0Vir || target(1) !== state0Vir)
			continue;
		if (state2Vir !== -1)
			throw Error("Login state dispatch matched more than once");
		state2Vir = target(2);
		if (target(3) !== state2Vir)
			throw Error("Login states 2 and 3 do not share the login window block");
	}
	if (state2Vir === -1)
		throw Error("Login state dispatch not found");

	const state2 = Exe.Vir2Phy(state2Vir, CODE);
	if (Exe.GetUint8(state2) !== 0x8B || Exe.GetUint8(state2 + 1) !== 0x0D)
		throw Error("Unexpected first instruction in the login window block");
	const state2First = Exe.GetHex(state2, 6);

	$$(_, '1.2 - Find the clientinfo connection list builder and the hooks that use it')
	const builderVir = Exe.Phy2Vir(findUnique(RestoreServiceSelectBuilder, "Clientinfo connection list builder"));
	const listHook = findUnique(RestoreServiceSelectListHook(builderVir), "Server list hook");
	const reopenVir = Exe.GetUint32(listHook + 8);
	if (Exe.GetUint32(listHook + 17) !== reopenVir)
		throw Error("Server list hook does not clear the flag it tests");
	findUnique(RestoreServiceSelectPickHook, "Service pick hook");

	$$(_, '1.3 - Find g_hideAccountList')
	const sites = FindEncStrSites("hideaccountlist");
	if (sites.length !== 1)
		throw Error(`'hideaccountlist' matched ${sites.length} sites (expected 1)`);
	const base = sites[0].call + 5;
	const readAddr = Exe.FindHex("0F B6" + WC + ALLWC, base, base + 0x40);
	if (readAddr < 0 || (Exe.GetUint8(readAddr + 2) & 0xC7) !== 0x05)
		throw Error("g_hideAccountList read not found");
	const hideVir = Exe.GetUint32(readAddr + 3);

	$$(_, '2.1 - Build the service select stubs')
	const [, onceVir] = Exe.AddUint32(0);

	const stub = (baseVir, gate, stock) => assemble(baseVir, [
		...gate,
		"80 3D" + reopenVir.toHex() + " 00",
		{short: "75", to: "show"},
		"80 3D" + onceVir.toHex() + " 00",
		{short: "75", to: "stock"},
		{label: "show"},
		"C6 05" + onceVir.toHex() + " 01",
		"80 3D" + hideVir.toHex() + " 00",
		{short: "75", to: "stock"},
		"FF B7 C8 01 00 00",
		"FF B7 C4 01 00 00",
		"57",
		"B8" + builderVir.toHex(),
		"FF D0",
		"83 BF C4 01 00 00 02",
		{short: "7C", to: "restore"},
		"83 C4 08",
		"8B 07 6A 06 8B CF FF 50 1C",
		{jmp: endVir},
		{label: "restore"},
		"8F 87 C4 01 00 00",
		"8F 87 C8 01 00 00",
		{label: "stock"},
		"C6 05" + reopenVir.toHex() + " 00",
		...stock
	]);

	const redirect = baseVir => assemble(baseVir, [
		"83 7F 04 01",
		{short: "77", to: "stock"},
		"80 3D" + onceVir.toHex() + " 00",
		{short: "75", to: "stock"},
		"C7 47 0C 02 00 00 00",
		{jmp: endVir},
		{label: "stock"},
		"8B 07 8B CF 6A 00 6A 00 6A 00 6A 00 6A 1C FF 50 18",
		{jmp: endVir}
	]);
	const gateB = ["83 7F 04 02", {short: "75", to: "stock"}];
	const stockB = [state2First, {jmp: state2Vir + 6}];

	const sizeA = redirect(0).byteCount();
	const [phyA, virA] = Exe.Allocate(sizeA);
	Exe.SetHex(phyA, redirect(virA));

	const sizeB = stub(0, gateB, stockB).byteCount();
	const [phyB, virB] = Exe.Allocate(sizeB);
	Exe.SetHex(phyB, stub(virB, gateB, stockB));

	$$(_, '2.2 - Send login states 0 and 1 to state 2 and hook the login window block')
	Exe.SetHex(state0, "E9" + ((virA - (state0Vir + 5)) >>> 0).toHex() + " 90".repeat(17));
	Exe.SetHex(state2, "E9" + ((virB - (state2Vir + 5)) >>> 0).toHex() + " 90");

	return Log.rise(true);
};

RestoreServiceSelect.validate = function()
{
	return Exe.FindHexN(RestoreServiceSelectState0, 0, Exe.FileSize).length === 1
		&& Exe.FindHexN(RestoreServiceSelectBuilder, 0, Exe.FileSize).length === 1;
};
